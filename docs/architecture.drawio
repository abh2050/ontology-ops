;CDK v2 stack + CDKToolkit" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="1240" y="800" width="56" height="56" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;user pool&lt;br&gt;no self sign-up&lt;br&gt;code + PKCE" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="360" y="640" width="56" height="56" as="geometry"/></mxCell><mxCell id="c31" value="① HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="② HTTP:80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="③ :8000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;entryX=0.5;entryY=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="④ SQL · TLS 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="outbox · leases · checkpoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.5;exitY=1;entryX=1;entryY=0.25;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="⑤ send · receive · delete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="928" y="178"/><mxPoint x="1205" y="178"/><mxPoint x="1205" y="198"/></Array></mxGeometry></mxCell><mxCell id="c38" value="redrive after 5 receives" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="⑥ Converse · strict JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#01A88D;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c17" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="483"/><mxPoint x="1180" y="358"/></Array></mxGeometry></mxCell><mxCell id="c40" value="sign-in · PKCE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="JWKS (verify token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c16" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="alarm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="198"/><mxPoint x="1700" y="358"/></Array></mxGeometry></mxCell><mxCell id="c43" value="&lt;b&gt;Numbered request path&lt;/b&gt;&lt;br&gt;① Browser → CloudFront over HTTPS (TLS terminates at the edge).&lt;br&gt;② CloudFront → ALB over HTTP:80; ALB security group admits only the AWS-managed&lt;br&gt;    prefix list com.amazonaws.global.cloudfront.origin-facing.&lt;br&gt;③ ALB → API task :8000 (api-sg admits only alb-sg).&lt;br&gt;④ API → RDS with sslmode=require; authorization predicate runs inside every query.&lt;br&gt;⑤ Worker relays the transactional outbox to SQS and consumes jobs (≤ 2 concurrent).&lt;br&gt;⑥ Worker calls Bedrock Converse; a deterministic validator checks every answer." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="900" width="720" height="150" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;All tasks&lt;/b&gt; pull the image from ECR, receive DB credentials from Secrets&lt;br&gt;Manager at start, and ship logs to CloudWatch. Egress to AWS APIs uses task&lt;br&gt;public IPs through the IGW (no NAT, no VPC endpoints: ~$0 fixed network cost).&lt;br&gt;API role: S3 only. Worker role: SQS + 2 Bedrock models. No role can approve&lt;br&gt;proposals except via the API's DB role." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1240" y="925" width="500" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>