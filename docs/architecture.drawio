html=1;strokeColor=#147EBA;fillColor=none;fontColor=#147EBA;dashed=1;fontSize=11;align=center;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="195" width="345" height="655" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Availability Zone B&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#147EBA;fillColor=none;fontColor=#147EBA;dashed=1;fontSize=11;align=center;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="835" y="195" width="340" height="655" as="geometry"/></mxCell><mxCell id="c11" value="Public subnet A · route 0.0.0.0/0 → IGW" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1"><mxGeometry x="492" y="225" width="322" height="360" as="geometry"/></mxCell><mxCell id="c12" value="Public subnet B · route 0.0.0.0/0 → IGW" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1"><mxGeometry x="847" y="225" width="316" height="360" as="geometry"/></mxCell><mxCell id="c13" value="Private isolated subnet A · local routes only" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1"><mxGeometry x="492" y="600" width="322" height="235" as="geometry"/></mxCell><mxCell id="c14" value="Private isolated subnet B · local routes only" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1"><mxGeometry x="847" y="600" width="316" height="235" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Application Load Balancer&lt;/b&gt;&lt;br&gt;HTTP:80 · spans both AZs&lt;br&gt;ingress: CloudFront prefix list only" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1"><mxGeometry x="802" y="275" width="56" height="56" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;ECS Fargate · API service&lt;/b&gt;&lt;br&gt;FastAPI + React UI · 1 task&lt;br&gt;0.25 vCPU · 0.5 GiB · ARM64&lt;br&gt;public IP for egress · api-sg" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="610" y="455" width="56" height="56" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;ECS Fargate · worker service&lt;/b&gt;&lt;br&gt;outbox relay + consumer · 1 task&lt;br&gt;0.5 vCPU · 1 GiB · ARM64&lt;br&gt;no inbound · worker-sg" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="900" y="455" width="56" height="56" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;One-off tasks&lt;/b&gt;&lt;br&gt;migrate · import · seed&lt;br&gt;ecs run-task" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="48" height="48" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Amazon RDS PostgreSQL 16&lt;/b&gt;&lt;br&gt;db.t4g.micro · single-AZ&lt;br&gt;20 GiB gp3 · encrypted · force_ssl&lt;br&gt;db-sg: 5432 from app SGs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="625" y="680" width="56" height="56" as="geometry"/></mxCell><mxCell id="c20" value="DB subnet group spans A and B.&lt;br&gt;Single-AZ: no standby runs in B&lt;br&gt;(Multi-AZ is the scale trigger)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#147EBA;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="870" y="770" width="270" height="60" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Amazon SQS · jobs&lt;/b&gt;&lt;br&gt;standard · 180 s visibility&lt;br&gt;4-day retention" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="1240" y="170" width="56" height="56" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;SQS dead-letter queue&lt;/b&gt;&lt;br&gt;after 5 receives&lt;br&gt;14-day retention" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="1500" y="170" width="56" height="56" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Converse API&lt;br&gt;Nova Lite · Nova 2 Lite (global)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1240" y="330" width="56" height="56" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;br&gt;logs (7 days) · alarms&lt;br&gt;DLQ not empty · queue age" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="56" height="56" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;AWS Secrets Manager&lt;/b&gt;&lt;br&gt;one secret per DB role&lt;br&gt;+ demo-users" style="sketch=0;