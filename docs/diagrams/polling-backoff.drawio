<mxfile host="build_diagrams.py"><diagram name="Scenario 3: timely job updates" id="polling-backoff"><mxGraphModel dx="1600" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="560" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Scenario 3: timely job updates&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Near real-time job visibility with conditional requests and exponential idle backoff · no WebSockets or SSE (not live commerce streaming)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1560" height="22" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#232F3E;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="1480" height="4" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#2F7D4F;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="84" y="234" width="16" height="16" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;t = 0 s&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="188" width="120" height="20" as="geometry"/></mxCell><mxCell id="c6" value="200 · rev 1 · running" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#2F7D4F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="262" width="160" height="40" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#879196;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="364" y="234" width="16" height="16" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;+2 s&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="330" y="188" width="120" height="20" as="geometry"/></mxCell><mxCell id="c9" value="304 Not Modified" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#879196;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="300" y="262" width="160" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#879196;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="644" y="234" width="16" height="16" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;+4 s&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="610" y="188" width="120" height="20" as="geometry"/></mxCell><mxCell id="c12" value="304 (idle ×2)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#879196;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="580" y="262" width="160" height="40" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#879196;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="924" y="234" width="16" height="16" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;+8 s&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="890" y="188" width="120" height="20" as="geometry"/></mxCell><mxCell id="c15" value="304 (idle ×3)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#879196;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="860" y="262" width="160" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#2F7D4F;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1204" y="234" width="16" height="16" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;+15 s (cap)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1170" y="188" width="120" height="20" as="geometry"/></mxCell><mxCell id="c18" value="200 · rev 2 · validating" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#2F7D4F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1140" y="262" width="160" height="40" as="geometry"/></mxCell><mxCell id="c19" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C4561F;fillColor=#C4561F;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1484" y="234" width="16" height="16" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;+2 s (reset)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1450" y="188" width="120" height="20" as="geometry"/></mxCell><mxCell id="c21" value="200 · rev 3 · ready → stop" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#C4561F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1420" y="262" width="160" height="40" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;How it works&lt;/b&gt;&lt;br&gt;• The browser sends If-None-Match with the last ETag; the API returns 304 when the job revision and the caller's scope are unchanged.&lt;br&gt;• Each unchanged poll doubles the interval (2 → 4 → 8 → 15 s cap); any change resets to 2 s; terminal states (ready, failed, blocked, unknown) stop polling.&lt;br&gt;• Saved results are re-authorized on every read; a scope change withholds them." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="900" height="110" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Why not push?&lt;/b&gt; Jobs finish in seconds and users watch one job at a time; polling with 304s is cheap, works through CloudFront and the ALB unchanged, and has no connection state. &lt;b&gt;Trigger for SSE/WebSockets&lt;/b&gt;: many concurrent watchers needing sub-second updates." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="990" y="330" width="550" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>