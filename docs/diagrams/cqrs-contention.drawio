<mxfile host="build_diagrams.py"><diagram name="Scenario 6: read/write contention (logical CQRS)" id="cqrs-contention"><mxGraphModel dx="1600" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Scenario 6: read/write contention (logical CQRS)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=28;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Separate command handlers and query services over one PostgreSQL database · optimistic revisions plus targeted locks · no separate read store" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1560" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Query side&lt;/b&gt; · backend/ops/queries&lt;br&gt;tools.py · graph.py · scope.py&lt;br&gt;plain SELECTs · no locks · authorization predicate first&lt;br&gt;read committed snapshots" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#147EBA;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="420" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Command side&lt;/b&gt; · backend/ops/commands&lt;br&gt;proposals.py: create_proposal · decide&lt;br&gt;one transaction per command" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="420" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;One PostgreSQL 16&lt;/b&gt;&lt;br&gt;jobs · proposals · cases ·&lt;br&gt;audit · source tables" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="760" y="250" width="64" height="64" as="geometry"/></mxCell><mxCell id="c6" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Guards on every approval&lt;/b&gt;&lt;br&gt;1. SELECT … FOR UPDATE on the proposal row&lt;br&gt;2. expected_revision ≠ current → &lt;b&gt;409&lt;/b&gt; (reload)&lt;br&gt;3. pg_advisory_xact_lock(batch | target) serializes competitors&lt;br&gt;4. re-check scope, evidence hash, ontology version, eligibility&lt;br&gt;5. UNIQUE(proposal_id) and UNIQUE(case_key) as the last line" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1000" y="230" width="560" height="150" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Measured (tests against PostgreSQL)&lt;/b&gt;: 4 concurrent approvals → exactly 1 case · 2 competing proposals for one target → 1 case + 1 stale (409) · stale revision → 409 · duplicate approval → 409." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="1500" height="55.57599999999999" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Deferred&lt;/b&gt;: separate read store or event sourcing; trigger: command and query contention visible in measured latency. API job reads use ETags, so polling does not hold locks." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="1500" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>