.0" y="90" width="40" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ALB&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="170" height="40" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#879196;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845.0" y="180" as="sourcePoint"/><mxPoint x="845.0" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="1065.0" y="90" width="40" height="40" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;API · FastAPI on Fargate&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="170" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#879196;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1085.0" y="180" as="sourcePoint"/><mxPoint x="1085.0" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="1305.0" y="90" width="40" height="40" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;RDS PostgreSQL&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1240" y="140" width="170" height="40" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#879196;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1325.0" y="180" as="sourcePoint"/><mxPoint x="1325.0" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="1  GET /oauth2/authorize · code_challenge (S256) · state" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="210" as="sourcePoint"/><mxPoint x="365.0" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="2  302 → /auth/callback?code&amp;state (state checked)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="262" as="sourcePoint"/><mxPoint x="125.0" y="262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="3  POST /oauth2/token · code + code_verifier" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="314" as="sourcePoint"/><mxPoint x="365.0" y="314" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="4  access token (kept in session memory only)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="366" as="sourcePoint"/><mxPoint x="125.0" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="5  GET /api/queue · Authorization: Bearer … · HTTPS" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="418" as="sourcePoint"/><mxPoint x="605.0" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="6  forward (Authorization + query; no caching) · HTTP:80" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605.0" y="470" as="sourcePoint"/><mxPoint x="845.0" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="7  :8000" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="845.0" y="522" as="sourcePoint"/><mxPoint x="1085.0" y="522" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="8  verify JWT: RS256 via cached JWKS · iss · exp · token_use · client_id" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1085.0" y="574" as="sourcePoint"/><mxPoint x="1085.0" y="592" as="targetPoint"/><Array as="points"><mxPoint x="1125.0" y="574"/><mxPoint x="1125.0" y="592"/></Array></mxGeometry></mxCell><mxCell id="c28" value="9  load principal: users + seller_grants (role ≠ scope)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1085.0" y="640" as="sourcePoint"/><mxPoint x="1325.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="10  scoped SQL: VISIBLE_ORDER predicate before joins/aggregates" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1085.0" y="692" as="sourcePoint"/><mxPoint x="1325.0" y="692" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="11  200 JSON · Cache-Control: private, no-store (hidden ⇒ identical 404)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1085.0" y="744" as="sourcePoint"/><mxPoint x="125.0" y="744" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;Why this is safe&lt;/b&gt;&lt;br&gt;• Scope is re-read from PostgreSQL on every request; nothing is cached by role.&lt;br&gt;• An order is visible only if every seller on it is granted to the caller.&lt;br&gt;• Logs carry route template, status, latency only: never IDs or tokens." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="640" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>