<mxfile host="build_diagrams.py"><diagram name="Scenario 1: scaling reads" id="read-scaling"><mxGraphModel dx="1640" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="760" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Scenario 1: scaling reads&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Where each read optimisation sits, what is deliberately not cached, and the deferred services with their triggers (dashed)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1600" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Browser · TanStack Query&lt;/b&gt;&lt;br&gt;query cache per view&lt;br&gt;ETag / If-None-Match on jobs + meta" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="230" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;API: TTL 0, forwards&lt;br&gt;Authorization (no shared cache)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="56" height="56" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;ALB&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="56" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;API (FastAPI)&lt;/b&gt;&lt;br&gt;✔ in-process cache: ontology metadata (immutable)&lt;br&gt;✔ JWKS cached; token verify ~0.08 ms&lt;br&gt;✘ never cached: roles, grants, approvals&lt;br&gt;✔ Cache-Control: private, no-store" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="680" y="105" width="330" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;✔ 6 indexes incl. orders(batch_id, estimated_at, order_id)&lt;br&gt;✔ late-open predicate rewritten to an index range&lt;br&gt;✔ keyset pagination (days, value, order_id)&lt;br&gt;✔ authorization predicate in the first CTE&lt;br&gt;EXPLAIN: queue page 12.4 ms · snapshot 0.2 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1080" y="95" width="400" height="150" as="geometry"/></mxCell><mxCell id="c8" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="scoped SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;Scoped result cache&lt;/b&gt; (deferred)&lt;br&gt;key = principal scope hash · ontology version&lt;br&gt;· batch · as_of · scenario · filters&lt;br&gt;trigger: repeated identical scoped reads dominate" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="680" y="330" width="330" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;RDS read replica&lt;/b&gt; (deferred)&lt;br&gt;trigger: p95 &gt; 750 ms at 20 readers&lt;br&gt;after indexing and keyset pagination" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1080" y="330" width="400" height="110" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c6" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c7" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Measured&lt;/b&gt;&lt;br&gt;• Deployed: p50 271 ms · &lt;b&gt;p95 591 ms&lt;/b&gt; · p99 889 ms · 58 req/s · 0 errors · 20 readers through CloudFront, 1 API task (0.25 vCPU).&lt;br&gt;• Local: p95 189 ms at 20 readers after caching the parsed JWT key (first run 947 ms: key re-parsed per request, 27 ms CPU each).&lt;br&gt;• Lesson recorded: the bottleneck was CPU in auth, not SQL; profiling before adding caches avoided an unnecessary replica." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="1450" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>