="259" as="sourcePoint"/><mxPoint x="510.0" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="202 {job_id}" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="303" as="sourcePoint"/><mxPoint x="110.0" y="303" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="relay: poll outbox every 2 s (SKIP LOCKED)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="347" as="sourcePoint"/><mxPoint x="510.0" y="347" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="SendMessage {job_id, event_id}" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="391" as="sourcePoint"/><mxPoint x="910.0" y="391" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="mark outbox sent" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="435" as="sourcePoint"/><mxPoint x="510.0" y="435" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="ReceiveMessage (visibility 180 s)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="479" as="sourcePoint"/><mxPoint x="710.0" y="479" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="claim 120 s lease · re-check scope" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="523" as="sourcePoint"/><mxPoint x="510.0" y="523" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="reserve model_call + admit (daily cap) · state=sent" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="567" as="sourcePoint"/><mxPoint x="510.0" y="567" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="Converse · planner (≤2k in / 512 out)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="611" as="sourcePoint"/><mxPoint x="1110.0" y="611" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="checkpoint plan" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="655" as="sourcePoint"/><mxPoint x="510.0" y="655" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="authorized tools (server-authored SQL)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="699" as="sourcePoint"/><mxPoint x="510.0" y="699" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="Converse · analyst (≤4k in / 768 out)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="743" as="sourcePoint"/><mxPoint x="1110.0" y="743" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="validator: IDs · numbers · causal language · eligibility" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="787" as="sourcePoint"/><mxPoint x="710.0" y="805" as="targetPoint"/><Array as="points"><mxPoint x="750.0" y="787"/><mxPoint x="750.0" y="805"/></Array></mxGeometry></mxCell><mxCell id="c36" value="state=ready + result + evidence hash" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="847" as="sourcePoint"/><mxPoint x="510.0" y="847" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="DeleteMessage (only after durable terminal state)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="891" as="sourcePoint"/><mxPoint x="910.0" y="891" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="poll GET /api/jobs/{id} (ETag) · POST …/proposal" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="935" as="sourcePoint"/><mxPoint x="310.0" y="935" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="POST /api/proposals/{id}/decision (expected_revision)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310.0" y="979" as="sourcePoint"/><mxPoint x="310.0" y="979" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="1 tx: lock proposal · advisory lock · re-check · INSERT case + audit" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="1023" as="sourcePoint"/><mxPoint x="510.0" y="1023" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;Failure handling (all drilled on the deployed stack)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Crash before ack&lt;/b&gt; → SQS redelivers after 180 s → claim sees a terminal job →&lt;br&gt;  ack without work → still exactly one case.&lt;br&gt;• &lt;b&gt;Bedrock timeout&lt;/b&gt; → job held &lt;i&gt;unknown&lt;/i&gt;; never auto-retried (ops recover-job).&lt;br&gt;• &lt;b&gt;5 known provider failures&lt;/b&gt; → circuit breaker open 60 s; one half-open probe.&lt;br&gt;• &lt;b&gt;Poison message&lt;/b&gt; → DLQ after 5 receives → CloudWatch alarm; no blind redrive.&lt;br&gt;• &lt;b&gt;Grant revoked mid-job&lt;/b&gt; → job blocked (SCOPE_CHANGED)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FDF3F4;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="1080" width="820" height="120" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Cost controls&lt;/b&gt;&lt;br&gt;• 100 admitted calls/day (live) · separate eval budget (ceiling 1,500).&lt;br&gt;• ≤ 2 concurrent jobs · ≤ 2 calls per job · SDK retries disabled.&lt;br&gt;• Measured: $0.00035 (Nova Lite) / $0.00206 (Nova 2 Lite) per completed job." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="870" y="1080" width="600" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>