<mxfile host="build_diagrams.py"><diagram name="Scenarios 4 and 5: job and paid-call state machines" id="state-machines"><mxGraphModel dx="1640" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="800" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Scenarios 4 and 5: job and paid-call state machines&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=28;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Every transition is a durable database write; the SQS message is acknowledged only from a terminal or held state" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1600" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;queued&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="140" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;running&lt;/b&gt;&lt;br&gt;lease 120 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="150" height="58.99199999999999" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;validating&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="150" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;ready&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="140" width="140" height="56" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;blocked&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#B4441C;fillColor=#FDF3F4;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="140" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;failed&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FDF3F4;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="280" y="340" width="150" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;unknown&lt;/b&gt;&lt;br&gt;held" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#B4441C;fillColor=#FDF3F4;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="140" height="58.99199999999999" as="geometry"/></mxCell><mxCell id="c10" value="claim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="analyst done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="report saved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="invalid JSON · rejected · deadline · cap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="scope changed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="302" y="310"/><mxPoint x="110" y="310"/></Array></mxGeometry></mxCell><mxCell id="c15" value="timeout · sent stage on reclaim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="407" y="228"/><mxPoint x="890" y="228"/></Array></mxGeometry></mxCell><mxCell id="c16" value="validator error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.3;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="368"/></Array></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Ack SQS&lt;/b&gt; only from ready · failed · blocked · unknown.&lt;br&gt;A crash before ack → redelivery → claim sees terminal → ack without work.&lt;br&gt;Unknown is resolved only by &lt;i&gt;ops recover-job&lt;/i&gt; (never auto-retried)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="600" height="93.15199999999999" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Paid model call (one row per job and stage)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="600" height="24" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;reserved&lt;/b&gt;&lt;br&gt;admitted against cap" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#01A88D;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="180" height="79.48799999999999" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;sent&lt;/b&gt;&lt;br&gt;persisted before call" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#01A88D;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="180" height="79.48799999999999" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;complete&lt;/b&gt;&lt;br&gt;+ checkpoint in 1 tx" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="200" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;known_failure&lt;/b&gt;&lt;br&gt;no generation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FDF3F4;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="140" y="660" width="180" height="60" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;unknown&lt;/b&gt;&lt;br&gt;may have generated" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#B4441C;fillColor=#FDF3F4;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="660" width="200" height="60" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="throttle / reject (1 retry if retryable)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336" y="615"/><mxPoint x="230" y="615"/></Array></mxGeometry></mxCell><mxCell id="c27" value="timeout · dropped connection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.9;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c20" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="462" y="615"/><mxPoint x="720" y="615"/></Array></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;Circuit breaker&lt;/b&gt; (process-local): 5 consecutive known failures → open 60 s → one half-open probe. Blocks admission, so no paid call is reserved.&lt;br&gt;&lt;b&gt;Reuse&lt;/b&gt;: a completed stage is reused after a crash only if request, scope, and evidence hashes still match.&lt;br&gt;&lt;b&gt;Reserved but never sent&lt;/b&gt; resumes safely." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="880" y="500" width="720" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>