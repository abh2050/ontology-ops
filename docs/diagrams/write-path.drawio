<mxfile host="build_diagrams.py"><diagram name="Scenario 2: the write path" id="write-path"><mxGraphModel dx="1680" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="760" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Scenario 2: the write path&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1640" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Bulk import and application writes · strict validation, batched COPY, one transaction, append-only audit, lease-guarded worker writes" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1640" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Bulk import (ECS one-off task, import role)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="700" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;5 Olist CSVs&lt;/b&gt;&lt;br&gt;S3 imports/ · exact headers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;types · IDs · money as Decimal → centavos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;Quarantine&lt;/b&gt;&lt;br&gt;reason codes · raw row kept · order cascade" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Dedupe&lt;/b&gt;&lt;br&gt;identical kept once · conflict fails import" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="720" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;COPY&lt;/b&gt;&lt;br&gt;1,000-row batches" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;One transaction&lt;/b&gt;&lt;br&gt;commit or nothing" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;Manifest&lt;/b&gt;&lt;br&gt;SHA-256 per file · same files ⇒ same hash" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Measured:&lt;/b&gt; 99,441 orders read → 99,252 loaded, 189 quarantined (166 carrier-before-purchase, 23 delivered-before-carrier) cascading 237 lines · &lt;b&gt;9.3 s&lt;/b&gt;, 424 MB peak · reimport = no-op." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="1590" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Application writes (API and worker roles)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="700" height="24" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Submit job&lt;/b&gt;&lt;br&gt;1 tx: job + outbox row + audit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="300" height="80" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Relay&lt;/b&gt;&lt;br&gt;outbox → SQS, then mark sent" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="352" y="360" width="300" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;lease-guarded checkpoint / result writes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="674" y="360" width="300" height="80" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Paid call&lt;/b&gt;&lt;br&gt;reserve model_call + admission before send" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#01A88D;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="996" y="360" width="300" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Approve&lt;/b&gt;&lt;br&gt;1 tx: case + proposal state + audit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1318" y="360" width="300" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Append-only audit&lt;/b&gt;: no runtime role holds UPDATE, DELETE, or TRUNCATE on audit_events (verified against PostgreSQL). Audit rows are written in the same transaction as the action they record, so an action and its audit commit together; they are not batched separately (deliberate, D-025)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1590" height="60" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Deferred (not built)&lt;/b&gt;: no sharding. Trigger to revisit: partition audit_events and model_calls by month, and use staging tables for incremental upserts, once the import becomes incremental rather than a full snapshot." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="550" width="1590" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>