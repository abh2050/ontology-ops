<mxfile host="build_diagrams.py"><diagram name="System design: six workload scenarios" id="system-design"><mxGraphModel dx="1700" dy="820" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;System design: six workload scenarios&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=28;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1660" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Each workload has a mechanism, measured evidence, and a recorded scale trigger for the service deliberately not built yet (spec section 13)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1660" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Scenario&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#EEF1F5;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="230" height="38.495999999999995" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Mechanism (built)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#EEF1F5;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="560" height="38.495999999999995" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Measured evidence&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#EEF1F5;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="400" height="38.495999999999995" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Scale trigger (deferred, not built)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#EEF1F5;fontColor=#232F3E;dashed=0;fontSize=17;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="80" width="420" height="38.495999999999995" as="geometry"/></mxCell><mxCell id="c7" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="44" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;1. Too many reads&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=18;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="95" y="128" width="165" height="100" as="geometry"/></mxCell><mxCell id="c9" value="6 targeted indexes · index-range late-order predicate · keyset pagination · ETags on job + metadata · in-process ontology metadata cache · scope never cached · Cache-Control: private, no-store" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="128" width="560" height="100" as="geometry"/></mxCell><mxCell id="c10" value="p95 591 ms @ 20 readers (deployed, CloudFront) · 189 ms local · 17 EXPLAIN ANALYZE plans, all runtime queries &lt; 20 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="128" width="400" height="100" as="geometry"/></mxCell><mxCell id="c11" value="Read replica if p95 &gt; 750 ms after indexing · scoped result cache keyed on scope hash, ontology version, batch, as_of, scenario, filters" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="128" width="420" height="100" as="geometry"/></mxCell><mxCell id="c12" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="44" height="44" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;2. Too many writes&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=18;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="95" y="240" width="165" height="100" as="geometry"/></mxCell><mxCell id="c14" value="COPY in 1,000-row batches inside one transaction · strict validation + quarantine · append-only audit (no UPDATE/DELETE grants) · import as a background ECS task" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="240" width="560" height="100" as="geometry"/></mxCell><mxCell id="c15" value="Full Olist import 99,252 orders + 112,413 lines in 9.3 s · identical reimport is a no-op (same manifest hash)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="400" height="100" as="geometry"/></mxCell><mxCell id="c16" value="No sharding · partition audit_events / model_calls by month when write volume grows · staging tables for incremental loads" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="240" width="420" height="100" as="geometry"/></mxCell><mxCell id="c17" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="44" height="44" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;3. Timely updates&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=18;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="95" y="352" width="165" height="100" as="geometry"/></mxCell><mxCell id="c19" value="UI polls job status every 2 s with If-None-Match → 304 · exponential idle backoff (2 → 4 → 8 → 15 s cap) · stops at terminal state · no WebSockets/SSE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="352" width="560" height="100" as="geometry"/></mxCell><mxCell id="c20" value="Browser tests: ETag 304 path, ≥ 1.8 s first interval, backoff sequence, stop on terminal" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="352" width="400" height="100" as="geometry"/></mxCell><mxCell id="c21" value="Server push (SSE or WebSocket via API Gateway) only if users need sub-second visibility at scale" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="352" width="420" height="100" as="geometry"/></mxCell><mxCell id="c22" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="44" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;4. Slow jobs&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=18;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="95" y="464" width="165" height="100" as="geometry"/></mxCell><mxCell id="c24" value="API returns 202 + job_id · transactional outbox → SQS · bounded worker (≤ 2 concurrent, 60 s deadline) · leases + checkpoints" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="464" width="560" height="100" as="geometry"/></mxCell><mxCell id="c25" value="Deployed job submit→ready 10–16 s · eval p95 ≤ 4.4 s per job · 404 eval jobs at 2-way concurrency" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="464" width="400" height="100" as="geometry"/></mxCell><mxCell id="c26" value="Scale worker tasks on SQS depth (ApproximateNumberOfMessages) · then a fleet-wide breaker in DynamoDB/Redis" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="464" width="420" height="100" as="geometry"/></mxCell><mxCell id="c27" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="40" y="604" width="44" height="44" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;5. Failures&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=18;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="95" y="576" width="165" height="100" as="geometry"/></mxCell><mxCell id="c29" value="Idempotency keys · 120 s leases · checkpoints · paid-call reservation before send · SDK retries off · 1 jittered retry only on confirmed no-generation · DLQ after 5 · circuit breaker" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="576" width="560" height="100" as="geometry"/></mxCell><mxCell id="c30" value="4/4 live drills: crash before ack → 1 case · Bedrock timeout → unknown hold · breaker opens after 5 · poison → DLQ + alarm; 15 reliability tests" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="576" width="400" height="100" as="geometry"/></mxCell><mxCell id="c31" value="Fleet-wide breaker once &gt; 1 worker · automated reconciliation runbook for unknown holds" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="576" width="420" height="100" as="geometry"/></mxCell><mxCell id="c32" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" vertex="1" parent="1"><mxGeometry x="40" y="716" width="44" height="44" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;6. Read/write contention&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=18;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="95" y="688" width="165" height="100" as="geometry"/></mxCell><mxCell id="c34" value="Logical CQRS: commands/ handlers vs queries/ services on one PostgreSQL · optimistic revision → 409 · row lock + advisory lock per target · UNIQUE(proposal_id), UNIQUE(case_key)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="688" width="560" height="100" as="geometry"/></mxCell><mxCell id="c35" value="4 concurrent approvals → 1 case · 2 competing proposals → 1 case + 1 stale · stale revision → 409" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#2F7D4F;fillColor=#F1F8F3;fontColor=#232F3E;dashed=0;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="688" width="400" height="100" as="geometry"/></mxCell><mxCell id="c36" value="Separate read store / event sourcing only if command–query contention shows in measured latency" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=1;fontSize=17;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="688" width="420" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>