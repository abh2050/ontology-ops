<mxfile host="build_diagrams.py"><diagram name="Network and security boundaries" id="network-security"><mxGraphModel dx="1600" dy="930" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="930" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Network and security boundaries&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Security groups, routes, and encryption in transit and at rest · every rule below is in infra/stack.py and verified by preflight / smoke tests" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1560" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Internet users&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="50" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;TLS 1.2+ · AWS cert&lt;br&gt;HTTP→HTTPS redirect" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="190" y="297" width="56" height="56" as="geometry"/></mxCell><mxCell id="c5" value="VPC 10.0.0.0/16" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="960" height="640" as="geometry"/></mxCell><mxCell id="c6" value="Public subnets (A, B) · 0.0.0.0/0 → IGW" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1"><mxGeometry x="350" y="130" width="540" height="580" as="geometry"/></mxCell><mxCell id="c7" value="Private isolated subnets (A, B) · no internet route" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1"><mxGeometry x="910" y="130" width="360" height="580" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;alb-sg&lt;/b&gt;  in: tcp/80 from pl-cloudfront-origin-facing" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD3522;fillColor=none;fontColor=#DD3522;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="230" height="190" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;ALB&lt;/b&gt;&lt;br&gt;listener HTTP:80" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1"><mxGeometry x="467" y="245" width="56" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;api-sg&lt;/b&gt;  in: tcp/8000 from alb-sg" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD3522;fillColor=none;fontColor=#DD3522;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="650" y="180" width="215" height="190" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;API task&lt;/b&gt;&lt;br&gt;uvicorn :8000" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="730" y="245" width="56" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;worker-sg&lt;/b&gt;  in: none" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD3522;fillColor=none;fontColor=#DD3522;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="230" height="180" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Worker task&lt;/b&gt;&lt;br&gt;egress only" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="467" y="480" width="56" height="56" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;oneoff-task-sg&lt;/b&gt;  in: none" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD3522;fillColor=none;fontColor=#DD3522;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="650" y="420" width="215" height="180" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;One-off tasks&lt;/b&gt;&lt;br&gt;migrate/import/seed" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;" vertex="1" parent="1"><mxGeometry x="735" y="485" width="48" height="48" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;db-sg&lt;/b&gt;  in: tcp/5432 from api-sg, worker-sg,&lt;br&gt;oneoff-task-sg · out: none" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD3522;fillColor=none;fontColor=#DD3522;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="940" y="300" width="300" height="200" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;RDS PostgreSQL 16&lt;/b&gt;&lt;br&gt;rds.force_ssl=1&lt;br&gt;storage encrypted (KMS)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="1062" y="375" width="56" height="56" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;AWS public APIs&lt;/b&gt;&lt;br&gt;SQS · Bedrock · ECR · Secrets Manager&lt;br&gt;CloudWatch · S3 · Cognito (HTTPS 443)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1330" y="450" width="240" height="90" as="geometry"/></mxCell><mxCell id="c19" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="HTTP 80 (origin)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="8000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="TLS 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="c11" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="TLS 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.5;exitY=1;entryX=0.25;entryY=1;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="640"/><mxPoint x="1076" y="640"/></Array></mxGeometry></mxCell><mxCell id="c24" value="TLS 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0.5;exitY=1;entryX=0.75;entryY=1;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="759" y="620"/><mxPoint x="1104" y="620"/></Array></mxGeometry></mxCell><mxCell id="c25" value="HTTPS 443 via public IP + IGW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#232F3E;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c13" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="508"/><mxPoint x="395" y="690"/><mxPoint x="1450" y="690"/></Array></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;Encryption and secrets&lt;/b&gt;&lt;br&gt;• Viewer↔CloudFront TLS; RDS connections sslmode=require with force_ssl.&lt;br&gt;• RDS storage, SQS (SSE-SQS), S3 (SSE-S3) encrypted at rest.&lt;br&gt;• DB passwords generated in Secrets Manager, injected as ECS secrets;&lt;br&gt;  never in images, env files, logs (SQLAlchemy hide_parameters=True).&lt;br&gt;• Browser keeps Cognito tokens in session memory only." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="520" height="130" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Accepted residual risk (demo, D-024)&lt;/b&gt;&lt;br&gt;CloudFront→ALB is HTTP inside AWS (no custom domain/cert). The prefix list&lt;br&gt;admits any CloudFront distribution, so the API still verifies a Cognito&lt;br&gt;access token and a provisioned user on every request." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD3522;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="580" y="760" width="480" height="130" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;Cognito: no self sign-up; users only via ops seed-users.&lt;br&gt;API verifies RS256 signature, issuer, expiry, token_use=access, client_id.&lt;br&gt;A valid token without a provisioned user grants no data." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1080" y="760" width="490" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>