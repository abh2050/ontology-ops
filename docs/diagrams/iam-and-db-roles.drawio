<mxfile host="build_diagrams.py"><diagram name="IAM task roles and database roles" id="iam-and-db-roles"><mxGraphModel dx="1640" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;IAM task roles and database roles&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Least privilege at two layers · IAM decides which AWS APIs a task may call; PostgreSQL grants decide which rows and columns it may touch (tested matrix)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1600" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;IAM (one role per duty)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="400" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;API task role&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="200" height="72" as="geometry"/></mxCell><mxCell id="c5" value="s3:GetObject imports/*&lt;br&gt;s3:Get/PutObject exports/*&lt;br&gt;&lt;i&gt;no&lt;/i&gt; Bedrock · &lt;i&gt;no&lt;/i&gt; SQS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="240" y="115" width="480" height="72" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Worker task role&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#01A88D;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="203" width="200" height="72" as="geometry"/></mxCell><mxCell id="c7" value="sqs:Send/Receive/DeleteMessage (jobs queue)&lt;br&gt;bedrock:InvokeModel (2 configured models only)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#01A88D;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="240" y="203" width="480" height="72" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Migration task role&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="291" width="200" height="72" as="geometry"/></mxCell><mxCell id="c9" value="no AWS API permissions&lt;br&gt;(DB master creds via ECS secrets)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="240" y="291" width="480" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Import task role&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="379" width="200" height="72" as="geometry"/></mxCell><mxCell id="c11" value="s3:GetObject imports/*" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#7AA116;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="240" y="379" width="480" height="72" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Seed task role&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="467" width="200" height="72" as="geometry"/></mxCell><mxCell id="c13" value="cognito-idp:AdminCreateUser / SetUserPassword / GetUser&lt;br&gt;secretsmanager: demo-users read/write" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="240" y="467" width="480" height="72" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Task execution roles&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="555" width="200" height="72" as="geometry"/></mxCell><mxCell id="c15" value="ecr pull · logs:PutLogEvents&lt;br&gt;secretsmanager:GetSecretValue (own DB secret)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="240" y="555" width="480" height="72" as="geometry"/></mxCell><mxCell id="c16" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="660" y="74" width="36" height="36" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;PostgreSQL roles (separate credentials per role)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="600" height="24" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;ops_admin&lt;/b&gt;&lt;br&gt;&lt;span style='color:#545B64'&gt;migration / owner&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="115" width="170" height="100" as="geometry"/></mxCell><mxCell id="c19" value="owns schema · runs Alembic · creates runtime roles" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FBF4FC;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="115" width="650" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;ops_import&lt;/b&gt;&lt;br&gt;&lt;span style='color:#545B64'&gt;import task&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="230" width="170" height="100" as="geometry"/></mxCell><mxCell id="c21" value="INSERT source + quarantine · UPDATE(manifest) · read/write synthetic tables" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FBF4FC;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="230" width="650" height="100" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;ops_api&lt;/b&gt;&lt;br&gt;&lt;span style='color:#545B64'&gt;API service&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="345" width="170" height="100" as="geometry"/></mxCell><mxCell id="c23" value="SELECT source/synthetic/app · INSERT jobs, outbox, proposals, cases, drafts, audit · UPDATE(state, revision, reviewed_by, review_reason) on proposals" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FBF4FC;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="345" width="650" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;ops_worker&lt;/b&gt;&lt;br&gt;&lt;span style='color:#545B64'&gt;worker service&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="460" width="170" height="100" as="geometry"/></mxCell><mxCell id="c25" value="SELECT source/synthetic · UPDATE(lease, checkpoint, result…) on jobs · UPDATE(sent_at) on outbox · INSERT/UPDATE model_calls, usage_days · &lt;b&gt;cannot&lt;/b&gt; insert cases or approve" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#C925D1;fillColor=#FBF4FC;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="460" width="650" height="100" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Never granted to any runtime role&lt;/b&gt;: UPDATE/DELETE on users or seller_grants · UPDATE/DELETE/TRUNCATE on audit_events · superuser, CREATEROLE, CREATEDB, BYPASSRLS.&lt;br&gt;Verified against PostgreSQL by tests/integration/test_m4_security.py (23 tables × 5 operations × 3 roles + every column-level UPDATE grant)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD3522;fillColor=#FDF3F4;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="580" width="830" height="80" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Approval integrity&lt;/b&gt; lives in the API role's single transaction: the reviewer must differ from the proposer and independently hold scope; stale revisions, duplicate approvals, and competing proposals return 409." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#879196;fillColor=#F7F8F8;fontColor=#232F3E;dashed=0;fontSize=10;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="680" width="830" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>