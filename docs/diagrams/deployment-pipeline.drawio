<mxfile host="build_diagrams.py"><diagram name="Build, deploy, verify, and tear down" id="deployment-pipeline"><mxGraphModel dx="1760" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="640" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Build, deploy, verify, and tear down&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=28;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1720" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Infrastructure as code with AWS CDK v2 · immutable ARM64 image · one-off ECS tasks for data · gated by preflight and verified by smoke tests and drills" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1720" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1. Preflight&lt;/b&gt;&lt;br&gt;account · region · SCP probes · Bedrock invoke · tags · cost table" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="215" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2. Tests + lint&lt;/b&gt;&lt;br&gt;pytest with Postgres · ruff · Playwright (GitHub Actions)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="275" y="120" width="215" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3. Docker build&lt;/b&gt;&lt;br&gt;linux/arm64 · uv sync --locked" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="215" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4. cdk bootstrap&lt;/b&gt;&lt;br&gt;CDKToolkit stack (once per account/region)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="765" y="120" width="215" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5. cdk synth + diff&lt;/b&gt;&lt;br&gt;84 resources · project tag on all" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1010" y="120" width="215" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;6. cdk deploy&lt;/b&gt;&lt;br&gt;services at desired count 0" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1255" y="120" width="215" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;7. ECR push&lt;/b&gt;&lt;br&gt;immutable release tag" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1500" y="120" width="215" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;8. run-task migrate&lt;/b&gt;&lt;br&gt;create DB roles · Alembic migrations" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="215" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;9. run-task import&lt;/b&gt;&lt;br&gt;S3 CSVs → validate → pick as_of → scenario" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1255" y="330" width="215" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;10. run-task seed&lt;/b&gt;&lt;br&gt;Cognito users + seller grants" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="215" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;11. cdk deploy (release)&lt;/b&gt;&lt;br&gt;API + worker to 1 task each" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="765" y="330" width="215" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;12. Verify&lt;/b&gt;&lt;br&gt;HTTPS smoke 18/18 · load p95 591 ms · 4 failure drills" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="215" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;13. Teardown&lt;/b&gt;&lt;br&gt;tagged inventory dry run → destroy (snapshot choice) → re-list" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="275" y="330" width="215" height="110" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=2;dashed=0;fontSize=14;labelBackgroundColor=#ffffff;fontColor=#232F3E;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="Developer laptop / GitHub Actions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="390" height="40" as="geometry"/></mxCell><mxCell id="c29" value="AWS control plane (CloudFormation, ECR)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="500" width="390" height="40" as="geometry"/></mxCell><mxCell id="c30" value="AWS runtime (ECS tasks, RDS, Cognito)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;dashed=0;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="500" width="390" height="40" as="geometry"/></mxCell><mxCell id="c31" value="Each paid step (deploy, release, model jobs, teardown) ran only after explicit owner approval with a cost estimate." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="1200" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>